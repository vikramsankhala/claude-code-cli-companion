{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(python -m pytest *)", "Bash(python kmp_cli.py *)", "Read(./**)"],
    "ask": ["Bash(git push *)"],
    "deny": ["Read(./data/**)", "Read(./.env)", "Bash(rm -rf *)"]
  },
  "env": { "KB_EMBEDDER": "hash" },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh", "timeout": 120 } ] }
    ]
  }
}
