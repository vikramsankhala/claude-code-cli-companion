{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(python -m pytest:*)", "Bash(./scripts/test-all.sh:*)", "Bash(pre-commit run:*)", "Bash(ruff check:*)", "Bash(git diff:*)", "Bash(git status)"],
    "ask": ["Bash(git push:*)", "Bash(pip install:*)"],
    "deny": ["Read(./.env)", "Read(./**/.env)", "Bash(rm -rf:*)", "Bash(git push --force:*)"]
  }
}
